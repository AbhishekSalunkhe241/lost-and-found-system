<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        /* Thumbnail hover zoom */
        .thumbnail {
            max-width: 100px;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        .thumbnail:hover {
            transform: scale(1.3);
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 9999;
            padding-top: 60px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.8);
        }
        .modal-content {
            margin: auto;
            display: block;
            max-width: 80%;
            border-radius: 10px;
        }
        .modal-close {
            position: absolute;
            top: 20px;
            right: 35px;
            color: #fff;
            font-size: 30px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

<header>
    <h1>Admin Dashboard</h1>
</header>

<div class="admin-container">

    <!-- SEARCH -->
    <form action="/admin" method="GET" style="margin-bottom: 20px;">
        <input 
            type="text" 
            name="search" 
            placeholder="Search by item or category..." 
            value="<%= search %>"
            style="padding:10px; width:60%; border-radius:10px;"
        >
        <button type="submit">Search</button>
    </form>

    <!-- LOST ITEMS -->
    <h2>Lost Items</h2>
    <% if (lostItems.length > 0) { %>
        <table>
            <tr>
                <th>Photo</th>
                <th>Item</th>
                <th>Category</th>
                <th>Date</th>
                <th>Location</th>
                <th>Contact</th>
                <th>Action</th>
            </tr>

            <% lostItems.forEach(item => { %>
            <tr>
                <td>
                    <% if (item.photo) { %>
                        <img src="/uploads/<%= item.photo %>" 
                             alt="Item Photo" 
                             class="thumbnail"
                             onclick="openModal('/uploads/<%= item.photo %>')">
                    <% } else { %>
                        No Photo
                    <% } %>
                </td>
                <td><%= item.itemName %></td>
                <td><%= item.category %></td>
                <td><%= item.date %></td>
                <td><%= item.location %></td>
                <td><%= item.contact %></td>
                <td>
                    <form action="/mark-found/<%= item._id %>" method="POST" style="display:inline;">
                        <button type="submit">Mark as Found</button>
                    </form>
                    <form action="/delete-lost/<%= item._id %>" method="POST" style="display:inline;">
                        <button type="submit" onclick="return confirm('Delete item?')">Delete</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>
    <% } else { %>
        <p>No lost items reported yet</p>
    <% } %>

    <!-- FOUND ITEMS -->
    <h2>Found Items</h2>
    <% if (foundItems.length > 0) { %>
        <table>
            <tr>
                <th>Photo</th>
                <th>Item</th>
                <th>Category</th>
                <th>Date</th>
                <th>Location</th>
                <th>Action</th>
            </tr>

            <% foundItems.forEach(item => { %>
            <tr>
                <td>
                    <% if (item.photo) { %>
                        <img src="/uploads/<%= item.photo %>" 
                             alt="Item Photo" 
                             class="thumbnail"
                             onclick="openModal('/uploads/<%= item.photo %>')">
                    <% } else { %>
                        No Photo
                    <% } %>
                </td>
                <td><%= item.itemName %></td>
                <td><%= item.category %></td>
                <td><%= item.date %></td>
                <td><%= item.location %></td>
                <td>
                    <form action="/delete-found/<%= item._id %>" method="POST">
                        <button type="submit" onclick="return confirm('Delete this item?')">Delete</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>
    <% } else { %>
        <p>No found items yet</p>
    <% } %>
</div>

<!-- BOTTOM HOME BUTTON -->
<div style="text-align:center; margin: 30px;">
    <a href="/index.html" class="btn"> Back to Home</a>
</div>

<!-- MODAL -->
<div id="photoModal" class="modal">
    <span class="modal-close" onclick="closeModal()">&times;</span>
    <img class="modal-content" id="modalImage">
</div>

<script>
function openModal(src) {
    document.getElementById("photoModal").style.display = "block";
    document.getElementById("modalImage").src = src;
}
function closeModal() {
    document.getElementById("photoModal").style.display = "none";
}
</script>

</body>
</html>